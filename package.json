{
  "name": "cart3r-gsm-pro",
  "version": "4.1.0",
  "description": "CART3R GSM PRO Windows companion",
  "main": "main.js",
  "author": "CART3R GSM",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ro.cart3r.gsmpro",
    "productName": "CART3R GSM PRO",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "manifest.webmanifest",
      "sw.js",
      "windows/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "CART3R-GSM-PRO-4.1-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
